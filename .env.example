# ----------------------------------------------------------------------------
# CortexSim GODMODE - environment variables
# Copy this file to .env.local for local dev, and add the same keys in Vercel
# (Project Settings -> Environment Variables). EVERYTHING here is OPTIONAL.
# The simulator runs fully client-side and works with zero env variables.
# ----------------------------------------------------------------------------

# Optional: MongoDB connection string. If set, the /api/simulations routes will
# persist saved experiments. If unset, the app falls back to in-browser storage.
# Example (MongoDB Atlas): mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGODB_URI=

# Optional: database name used for persistence (defaults to "cortexsim").
MONGODB_DB=cortexsim

# Optional: public site URL, used for share links and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://cortexsim-godmode.vercel.app

# Optional: analytics id (left blank disables analytics).
NEXT_PUBLIC_ANALYTICS_ID=
