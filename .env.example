# ============================================================================
# CortexSim environment variables
# ============================================================================
# Copy this file to `.env.local` for local dev. On Vercel, set the same keys
# under Project Settings -> Environment Variables (Production + Preview).
#
# Required keys are marked [REQUIRED]. Everything else is optional with a sane
# default in code.
# ============================================================================

# [REQUIRED in production] Secret used to sign session cookies + API tokens.
# Generate with:  openssl rand -hex 48
# Rotating this value will sign every user out and invalidate every API token.
CORTEXSIM_SECRET=replace-me-with-a-long-random-hex-string

# [OPTIONAL] Public site URL. Used for emails, share links, and OpenGraph.
# Set this to your deployed origin (no trailing slash). Vercel auto-injects
# VERCEL_URL when this is not set.
NEXT_PUBLIC_SITE_URL=https://your-cortexsim.vercel.app

# [OPTIONAL] Override the on-disk workspace data directory.
# Default is `<project>/.cortexsim-db`. On serverless platforms (Vercel,
# Netlify) the filesystem is read-only except for /tmp -- either point this
# to /tmp/cortexsim-db (data is ephemeral!) or migrate to a managed DB.
CORTEXSIM_DATA_DIR=.cortexsim-db

# [OPTIONAL] Default admin email. The very first signup is auto-promoted to
# admin regardless of this value; this is just a hint for documentation.
CORTEXSIM_ADMIN_EMAIL=you@example.com

# ----------------------------------------------------------------------------
# Future / optional integrations (left here for reference; safe to ignore)
# ----------------------------------------------------------------------------

# MongoDB connection string. Not used by the file-backed store; provided as a
# placeholder for teams migrating to managed Mongo.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cortexsim

# Postgres connection string (Neon, Supabase, RDS). Same note as above.
# DATABASE_URL=postgres://user:pass@host:5432/cortexsim

# OpenAI / model providers (for future Studio AI assist features).
# OPENAI_API_KEY=sk-...

# Outbound email (for password reset, invites; not yet enabled).
# RESEND_API_KEY=re_...
# EMAIL_FROM=no-reply@your-domain.com

# Sentry / error reporting (optional).
# SENTRY_DSN=https://...
# NEXT_PUBLIC_SENTRY_DSN=https://...
