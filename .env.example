# ============================================================
# CortexSim Pro — Environment Variables (TEMPLATE / HEADINGS ONLY)
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env.local` or real secrets. Only this template
# (with empty values) belongs in git.
#
# CortexSim Pro runs FULLY client-side by default, so NONE of these
# are required to run the app. They only enable optional cloud /
# integration features described in the roadmap.
#
# In Vercel: Project → Settings → Environment Variables, add the
# keys below (names only here — paste real values in the dashboard,
# not in the repo).
# ============================================================

# ---- Optional: hosted AI Copilot endpoint (LLM proxy) ----
# If unset, the Copilot uses the built-in offline rule-based parser.
PUBLIC_LLM_ENDPOINT=

# ---- Optional: Supabase (cloud sync / saved experiments) ----
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional: analytics / error tracking ----
PUBLIC_POSTHOG_KEY=
PUBLIC_SENTRY_DSN=

# ---- Optional: collaboration signaling server (WebRTC / Yjs) ----
PUBLIC_COLLAB_SIGNALING_URL=

# ---- Build metadata (auto-set by Vercel; safe to leave blank) ----
PUBLIC_APP_VERSION=
