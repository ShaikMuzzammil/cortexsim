# ============================================================
# CortexSim Pro — .gitignore
# Keep the repo pure source. Never commit dependencies, build
# output, secrets, or OS/editor noise.
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/
bower_components/

# Build / output
.next/
out/
dist/
build/
.vercel/
.cache/
.turbo/
*.tsbuildinfo

# Environment & secrets (NEVER commit real values)
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
secrets.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / tests
coverage/
.nyc_output/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Misc runtime / large data
*.zip
*.npy
*.mat
*.h5
recordings/
tmp/
